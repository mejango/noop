PRIVATE_KEY=your_wallet_private_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here
THEGRAPH_API_KEY=your_thegraph_api_key_here
NOOP_WRITE_TOKEN=choose_a_long_random_write_token
