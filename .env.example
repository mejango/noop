PRIVATE_KEY=your_wallet_private_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here
THEGRAPH_API_KEY=your_thegraph_api_key_here
NOOP_WRITE_TOKEN=choose_a_long_random_write_token
DATA_DIR=/data
# Off-platform ETH covered by the put insurance budget. Set on BOTH the bot and
# dashboard services — the dashboard uses it for the put budget and the P&L equity line.
PUT_INSURED_EXTERNAL_ETH=0

# Bot model roles. ANTHROPIC_STRATEGY_MODEL replaces ANTHROPIC_OPUS_MODEL.
ANTHROPIC_STRATEGY_MODEL=claude-fable-5-1
ANTHROPIC_SONNET_MODEL=claude-sonnet-5
OPENAI_STRATEGY_MODEL=gpt-6-astra
OPENAI_CONFIRMATION_MODEL=gpt-5.6-terra
