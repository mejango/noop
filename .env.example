PRIVATE_KEY=your_wallet_private_key_here
# Derive cutover: deploy with maintenance=true, then configure BOTH services.
DERIVE_API_VERSION=v2
DERIVE_NETWORK=mainnet
DERIVE_MAINTENANCE=true
# Resume snapshots/accounting while keeping trading and advisory changes paused.
DERIVE_COLLECT_DATA=false
# V3 requires the confirmed EOA/multisig owner and migrated subaccount ID.
# DERIVE_WALLET=0x...
# DERIVE_SUBACCOUNT_ID=...
# DERIVE_HISTORY_FROM=2026-10-06T17:55:00.000Z
# URL and domain are selected from version/network; optional overrides must match.
# DERIVE_API_URL=https://api.derive.xyz/v3
# DERIVE_DOMAIN_SEPARATOR=0xda616dfabb88681b08e1592820a41d55ddc62d68de110e327ae99d734506fe19
ETHERSCAN_API_KEY=your_etherscan_api_key_here
THEGRAPH_API_KEY=your_thegraph_api_key_here
NOOP_WRITE_TOKEN=choose_a_long_random_write_token
DATA_DIR=/data
# Off-platform ETH covered by the put insurance budget. Set on BOTH the bot and
# dashboard services — the dashboard uses it for the put budget and the P&L equity line.
PUT_INSURED_EXTERNAL_ETH=0

# Bot model roles. ANTHROPIC_STRATEGY_MODEL replaces ANTHROPIC_OPUS_MODEL.
ANTHROPIC_STRATEGY_MODEL=claude-fable-5-1
ANTHROPIC_SONNET_MODEL=claude-sonnet-5
OPENAI_STRATEGY_MODEL=gpt-6-astra
OPENAI_CONFIRMATION_MODEL=gpt-5.6-terra

# TypeSafe System One judgments over wiki prose (repair safeguards, regime/cost signals, ingest routing). Optional; keyword fallbacks apply without it.
TYPESAFE_API_KEY=
