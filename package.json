{
  "name": "eth-options-dashboard",
  "version": "1.0.0",
  "description": "Real-time ETH options trading dashboard",
  "main": "dashboard_server.js",
  "scripts": {
    "start": "node dashboard_server.js",
    "test": "node test/trading-system.test.js && node --test test/model-api.test.js test/strategy-*.test.js",
    "bot": "node bot/index.js",
    "bot:standalone": "node script.js",
    "dashboard": "node dashboard_server.js",
    "research:correlate": "node scripts/profit-correlation-report.js",
    "research:correlate:deep": "node scripts/profit-correlation-report.js --sample=all-candidates",
    "research:backtest:calls": "node scripts/sell-call-backtest.js",
    "research:analyze:call-dte": "node scripts/analyze-call-dte-normalization.js",
    "research:analyze:call-window": "node scripts/analyze-sell-call-dte-window.js",
    "research:analyze:constant-call": "node scripts/analyze-call-constant-maturity.js",
    "research:analyze:simple-call-scores": "node scripts/research-simple-call-scores.js",
    "research:study:economic-call-value": "node scripts/research-economic-call-value.js",
    "research:validate:call-dte": "node scripts/validate-call-dte-exponent.js",
    "research:tune:call-edge": "node scripts/tune-sell-call-edge.js",
    "test:backtest": "node test/sell-call-backtest.test.js",
    "v3:install": "npm ci --prefix integrations/derive-v3 --ignore-scripts --no-audit --no-fund",
    "test:v3": "node --test test/derive-v3*.test.js",
    "v3:public": "node integrations/derive-v3/cli.js public",
    "v3:init": "node integrations/derive-v3/cli.js init",
    "v3:account": "node integrations/derive-v3/cli.js account",
    "v3:order": "node integrations/derive-v3/cli.js order",
    "v3:deposit": "node integrations/derive-v3/cli.js deposit",
    "v3:reconcile": "node integrations/derive-v3/cli.js reconcile",
    "bot:v3:testnet": "node integrations/derive-v3/run-bot.js",
    "dashboard:v3:testnet": "node integrations/derive-v3/run-dashboard.js",
    "v3:handoff-check": "node integrations/derive-v3/handoff.js",
    "v3:discover": "node integrations/derive-v3/cli.js discover",
    "v3:snapshot:v2": "node integrations/derive-v3/capture-snapshot.js v2",
    "v3:snapshot:mainnet": "node integrations/derive-v3/capture-snapshot.js v3-mainnet",
    "v3:prepare-state": "node integrations/derive-v3/prepare-state.js",
    "bot:v3:mainnet": "node integrations/derive-v3/run-bot.js --mainnet",
    "v3:signing": "node integrations/derive-v3/cli.js signing",
    "test:strategy": "node --test test/strategy-*.test.js",
    "strategy:replay": "node scripts/strategy-replay.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "ethers": "^6.8.0",
    "express": "^4.18.2",
    "technicalindicators": "^3.1.0"
  },
  "keywords": [
    "trading",
    "options",
    "ethereum",
    "dashboard",
    "visualization"
  ],
  "author": "Trading Bot",
  "license": "MIT"
}
