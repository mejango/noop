# Load this into a separate shell/process. Never source it into the V2 service.
NOOP_VENUE=v3-testnet
DERIVE_V3_TESTNET_OWNER_ADDRESS=
DERIVE_V3_TESTNET_SUBACCOUNT_ID=
# Dedicated key file; PRIVATE_KEY and .private_key.txt are never used by V3.
DERIVE_V3_TESTNET_KEY_FILE=
DERIVE_V3_TESTNET_EXECUTION=disabled
# Switch only the line above to enabled for testnet order/cancel tests.
# The full testnet bot uses separate data and knowledge directories automatically.
