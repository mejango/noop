{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "input-bundle.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "noop.strategy/v1"
    },
    "input_bundle_id": {
      "$ref": "common.json#/$defs/digest"
    },
    "strategy_release_id": {
      "$ref": "common.json#/$defs/id"
    },
    "release_digest": {
      "$ref": "common.json#/$defs/digest"
    },
    "mandate_id": {
      "$ref": "common.json#/$defs/id"
    },
    "mandate_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "evaluated_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "invocation_reason": {
      "enum": [
        "scheduled",
        "market_event",
        "account_event",
        "manual",
        "replay"
      ]
    },
    "account": {
      "$ref": "common.json#/$defs/account"
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
      },
      "maxProperties": 512,
      "additionalProperties": {
        "$ref": "common.json#/$defs/field"
      }
    },
    "instrument_fields": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
      },
      "maxProperties": 1032,
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
        },
        "maxProperties": 512,
        "additionalProperties": {
          "$ref": "common.json#/$defs/field"
        }
      }
    },
    "instruments": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
      },
      "maxProperties": 1000,
      "additionalProperties": {
        "$ref": "common.json#/$defs/instrument"
      }
    },
    "private_state": {
      "$ref": "common.json#/$defs/private_state"
    },
    "control_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "active_intents": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/active_intent"
      },
      "maxItems": 1000
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": true
    }
  },
  "required": [
    "contract_version",
    "input_bundle_id",
    "strategy_release_id",
    "release_digest",
    "mandate_id",
    "mandate_revision",
    "sequence",
    "evaluated_at",
    "invocation_reason",
    "account",
    "fields",
    "instrument_fields",
    "instruments",
    "private_state",
    "control_revision",
    "active_intents",
    "extensions"
  ],
  "additionalProperties": false
}
